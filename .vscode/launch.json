{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Django API (Codespaces)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/octofit-tracker/backend/octofit_tracker/manage.py",
      "args": [
        "runserver",
        "0.0.0.0:8000"
      ],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "CODESPACE_NAME": "${env:CODESPACE_NAME}"
      }
    },
    {
      "name": "Launch Express Backend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/octofit-tracker/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "PORT": "8000"
      }
    },
    {
      "name": "Launch Vite Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/octofit-tracker/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--host",
        "0.0.0.0"
      ],
      "env": {
        "VITE_CODESPACE_NAME": "${env:CODESPACE_NAME}"
      }
    }
  ]
}
